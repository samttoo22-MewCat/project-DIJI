# 本機模型請求。未設定時仍可使用 UI 與資料結構預覽。
OPENROUTER_API_KEY=

# 公開部署才需要設定。請勿把真實值提交。
DIJI_AUTH_REQUIRED=false
DIJI_GOOGLE_CLIENT_ID=
DIJI_GOOGLE_CLIENT_SECRET=
DIJI_GOOGLE_OAUTH_CALLBACK_URL=
DIJI_CREDENTIAL_ENCRYPTION_KEY=

# 單程序公開部署的生成工作限制；API 寫入體積限制也適用於本機模式。
DIJI_MAX_GENERATIONS=8
DIJI_MAX_GENERATIONS_PER_USER=2
DIJI_GENERATIONS_PER_MINUTE=20
DIJI_GENERATION_TIMEOUT=180
DIJI_MAX_API_BODY_BYTES=1048576
